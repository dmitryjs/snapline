<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Экспорт видео" Width="474" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#202126" Foreground="#E9EAF0" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
 <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EFF0F5"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Background" Value="#191A1E"/><Setter Property="BorderBrush" Value="#41434C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="Height" Value="31"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style x:Key="Value" TargetType="Border"><Setter Property="Padding" Value="8,5"/><Setter Property="Background" Value="#1B1C20"/><Setter Property="BorderBrush" Value="#383A43"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
 </Window.Resources>
 <Border BorderBrush="#45464E" BorderThickness="1" Padding="21,12,21,19"><StackPanel>
 <Grid Height="32" Margin="0,0,0,10"><TextBlock Text="Экспорт видео" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Name="Dismiss" Style="{StaticResource Flat}" Width="26" HorizontalAlignment="Right" ToolTip="Закрыть" IsCancel="True" AutomationProperties.Name="Закрыть"><Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#C0C1CA" StrokeThickness="1.3"/></Button></Grid>
 <TextBlock Text="Название"/><TextBox Name="FileNameBox" Margin="0,5,0,14" AutomationProperties.Name="Название файла"/>
 <TextBlock Text="Сохранить в"/><DockPanel Margin="0,5,0,14"><Button Name="Browse" DockPanel.Dock="Right" Width="34" Margin="5,0,0,0" ToolTip="Выбрать папку" AutomationProperties.Name="Выбрать папку"><Path Data="M0,1 L6,1 8,3 16,3 16,12 0,12 Z" Stroke="#D5D6DD" StrokeThickness="1.4"/></Button><TextBox Name="Destination" AutomationProperties.Name="Папка назначения"/></DockPanel>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Формат"/><Border Style="{StaticResource Value}"><TextBlock Text="MP4"/></Border><TextBlock Text="Частота кадров" Margin="0,12,0,0"/><Border Style="{StaticResource Value}"><TextBlock Text="30 кадров/с"/></Border></StackPanel>
 <StackPanel Grid.Column="2"><TextBlock Text="Разрешение"/><ComboBox Name="Resolution" Height="31" Margin="0,5,0,0"/><TextBlock Text="Качество" Margin="0,12,0,0"/><ComboBox Name="Quality" Height="31" Margin="0,5,0,0"/></StackPanel></Grid>
 <TextBlock Name="Error" TextWrapping="Wrap" Foreground="#FDA99A" Visibility="Collapsed" Margin="0,10,0,0"/>
 <Button Name="Confirm" Content="Экспорт" IsDefault="True" Background="{StaticResource ExportFill}" Height="35" Margin="0,16,0,0" FontWeight="SemiBold"/>
 </StackPanel></Border></Window>
