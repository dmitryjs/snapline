<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Title="Snapline · Запись" Width="882" Height="370" ResizeMode="CanMinimize" Background="#080808" Foreground="#EEEEF2" FontFamily="Segoe UI" FontSize="13" WindowStyle="None" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Viewbox Stretch="Uniform"><Grid Width="882" Height="370"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
 <Grid Name="TitleBar" Height="39" Background="#121316"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="2,4"><Button Name="Minimize" Style="{StaticResource Flat}" Width="32" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" ><Viewbox Width="16" Height="16" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M5,12 L19,12" Stroke="#D1D3DC" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button><Button Name="CloseWindow" Style="{StaticResource Flat}" Width="32" ToolTip="Закрыть" AutomationProperties.Name="Закрыть" ><Viewbox Width="16" Height="16" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="#D1D3DC" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button></StackPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0"><Image Name="Brand" Width="22" Height="22"/><TextBlock Text="Snapline" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="15" Foreground="#DADBE2" VerticalAlignment="Center"/></StackPanel><Border Width="1" Height="18" Background="#34353A" Margin="5,0,8,0"/><Button Name="FileBtn" Style="{StaticResource Flat}" ToolTip="Открыть видео, выбрать папку или обновить устройства"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M2,5 L8,5 10,7 21,7 21,19 2,19 Z M2,9 L21,9" Stroke="#D1D3DC" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Файл" Margin="6,0,3,0"/></StackPanel></Button></StackPanel><TextBlock Name="Status" Foreground="#B7B8BF" Margin="12,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Grid>
 <Grid Grid.Row="1" Margin="20,19,20,22"><Grid.ColumnDefinitions><ColumnDefinition Width="570"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Выберите режим записи" Foreground="#A9A9AE" FontSize="14" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Card}" Name="ScreenBtn" Height="166" Width="176" Margin="0,0,14,0" AutomationProperties.Name="Весь экран"><StackPanel Margin="0,10,0,0"><Image Name="ScreenArt" Width="140" Height="79" Stretch="Fill"/><TextBlock Text="Весь экран" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Button><Button Style="{StaticResource Card}" Name="AreaBtn" Height="166" Width="176" Margin="0,0,14,0" AutomationProperties.Name="Область"><StackPanel Margin="0,10,0,0"><Image Name="AreaArt" Width="140" Height="79" Stretch="Fill"/><TextBlock Text="Область" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Button><Button Style="{StaticResource Card}" Name="WindowBtn" Height="166" Width="176" Margin="0,0,14,0" AutomationProperties.Name="Окно"><StackPanel Margin="0,10,0,0"><Image Name="WindowArt" Width="140" Height="79" Stretch="Fill"/><TextBlock Text="Окно" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Button></StackPanel></StackPanel>
 <Border Grid.Column="1" Background="#212225" Margin="0,31,0,3"/>
 <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="Устройства и запись" Foreground="#A9A9AE" FontSize="14" Margin="0,0,0,13"/>
 <DockPanel Height="32"><Border Width="33" CornerRadius="6" Background="#17181B" Margin="0,0,6,0"><Viewbox Width="18" Height="18" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3,4 L21,4 21,16 3,16 Z M12,16 L12,20 M8,20 L16,20" Stroke="#D1D3DC" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border><ComboBox Name="Target" AutomationProperties.Name="Источник записи"/></DockPanel>
 <DockPanel Height="32" Margin="0,9,0,0"><Button Name="MicButton" Width="33" Padding="3" Background="#17181B" Margin="0,0,6,0" ToolTip="Включить или выключить микрофон" AutomationProperties.Name="Микрофон"><Viewbox Width="18" Height="18" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M9,10 L9,6 C9,2 15,2 15,6 L15,10 C15,14 9,14 9,10 Z M5,10 C5,19 19,19 19,10 M12,17 L12,21 M9,21 L15,21" Stroke="#D1D3DC" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button><Grid><ComboBox Name="Inputs" AutomationProperties.Name="Выбор микрофона" ToolTip="Выбор микрофона"/><Border Name="MicCover" Background="#18191D" CornerRadius="6" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=MicOff}"/><TextBlock Name="MicOff" Text="Выключен" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#ACADB5"/></Grid></DockPanel>
 <Border Height="32" Margin="0,9,0,0" Background="#17181B" CornerRadius="6" Padding="8,0"><CheckBox Name="Clicks" Content="Подсветка кликов"/></Border>
 <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <StackPanel Margin="0,0,3,0"><TextBlock Text="Разрешение" FontSize="11" Margin="2,0,0,4"/><ComboBox Name="CaptureSize" Height="32" ToolTip="Максимальное разрешение записи" AutomationProperties.Name="Разрешение записи"/></StackPanel>
 <StackPanel Grid.Column="1" Margin="3,0,0,0"><TextBlock Text="Качество" FontSize="11" Margin="2,0,0,4"/><ComboBox Name="CaptureLevel" Height="32" AutomationProperties.Name="Качество записи"/></StackPanel></Grid>
 <Border Height="1" Background="#212225" Margin="0,9,0,8"/>
 <Button Name="RecordBtn" Height="32" Background="#191A20"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#FF585E" Margin="0,0,8,0"/><TextBlock Name="RecordLabel" Text="Записать" FontWeight="SemiBold"/></StackPanel></Button>
 </StackPanel></Grid></Grid></Viewbox></Window>